# Database — use SQLite for local dev (no Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# For PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finance_db

# AI — Google Gemini (required for AI assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# Market data source: DEMO | USER_PROVIDED | LIVE
MARKET_DATA_SOURCE=DEMO

# CSV upload limits (bytes)
CSV_MAX_SIZE_BYTES=5242880
